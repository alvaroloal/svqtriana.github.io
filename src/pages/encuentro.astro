---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import AzulejoPattern from '../components/deco/AzulejoPattern.astro';
import RioWave from '../components/deco/RioWave.astro';
import cartelPunto from '../assets/carteles/cartelPunto.jpg';
import { encuentro } from '../data/encuentro';

const title = 'Dónde nos vemos | PS SVQ Triana';
const description = encuentro.descripcion;
---

<BaseLayout title={title} description={description} canonicalPath="/encuentro">
  <PageHeader kicker="Punto de encuentro">{encuentro.titulo}</PageHeader>

  <section class="py-16 sm:py-20">
    <div class="site-container grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-start lg:gap-16">
      <figure class="polaroid mx-auto w-full max-w-xl lg:sticky lg:top-28">
        <Picture
          src={cartelPunto}
          alt="Cartel de la Cervecería el Punto de Triana, punto de encuentro de PS SVQ Triana"
          formats={['avif', 'webp']}
          widths={[480, 720, 1080]}
          sizes="(min-width: 1024px) 34rem, (min-width: 640px) 36rem, 90vw"
          loading="lazy"
          decoding="async"
          class="h-auto w-full"
        />
      </figure>

      <div>
        <p class="kicker text-sevilla-700">Triana</p>
        <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight sm:text-5xl">Nos vemos aquí</h2>
        <p class="mt-4 text-lg leading-relaxed text-noche-950/75">
          {encuentro.lugar}, {encuentro.zona}.
        </p>

        <div
          class="mt-8 overflow-hidden rounded-[var(--radius-azulejo)] border border-noche-950/10 bg-white shadow-[0_18px_40px_-28px_rgb(26_20_20/0.5)]"
          data-map
        >
          <button
            type="button"
            data-map-load
            data-map-src={encuentro.mapsEmbed}
            data-map-title="Mapa de la Cervecería el Punto de Triana"
            class="group relative isolate flex h-[22rem] w-full flex-col justify-end overflow-hidden bg-cal-100 text-left"
          >
            <AzulejoPattern class="absolute inset-0 -z-10 h-full w-full text-azulejo-700/15" />
            <RioWave class="absolute inset-x-0 top-1/3 -z-10 h-10 w-full text-azulejo-700/40" />
            <span class="absolute left-1/2 top-[38%] -translate-x-1/2 -translate-y-full" aria-hidden="true">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-sevilla-500 text-white shadow-[0_0_0_10px_rgb(223_6_6/0.18)] transition-transform duration-300 group-hover:-translate-y-1">
                <Icon name="pin" size={26} />
              </span>
            </span>
            <span class="flex w-full items-center gap-4 border-t border-noche-950/10 bg-white p-5 transition-colors group-hover:bg-cal-50">
              <span class="min-w-0 flex-1">
                <span class="block font-bold text-noche-950">{encuentro.lugar}</span>
                <span class="block text-sm text-noche-950/70">{encuentro.zona}</span>
              </span>
              <span class="inline-flex items-center gap-2 rounded-[var(--radius-azulejo)] bg-sevilla-500 px-4 py-2.5 text-xs font-bold uppercase tracking-[0.12em] text-white transition-colors group-hover:bg-sevilla-700">
                Ver mapa
              </span>
            </span>
          </button>
        </div>

        <p class="mt-5 text-sm">
          <a
            href={encuentro.mapsLink}
            class="inline-flex items-center gap-2 font-bold underline decoration-noche-950/30 underline-offset-4 transition-colors hover:text-sevilla-700"
            target="_blank"
            rel="noopener noreferrer"
          >
            Abrir en Google Maps
            <Icon name="external" size={14} />
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
