---
interface Props {
  class?: string;
  /** Escala del tramo (1 = 64 px de alto). La clase debe fijar la altura a juego. */
  scale?: number;
}

const { class: className = '', scale = 1 } = Astro.props;

// Tramo del Puente de Isabel II: un arco rebajado entre dos pilas, el tablero
// encima y los aros en las enjutas, cada vez más pequeños hacia la clave.
// Se dibuja como patrón en unidades de usuario, así se repite sin deformarse
// a cualquier ancho (un viewBox con preserveAspectRatio="none" aplastaba los aros).
const W = 180;
const H = 64;
const DECK = 17;
const CONTROL_Y = -2;

const archY = (x: number) => {
  const t = x / W;
  return H * (1 - t) ** 2 + 2 * t * (1 - t) * CONTROL_Y + H * t ** 2;
};

type Ring = { cx: number; cy: number; r: number };
const half: Ring[] = [];
let x0 = 3;
while (x0 < W / 2) {
  let r = 12;
  // El aro cabe si el arco, en su borde más cercano a la clave, queda por debajo.
  while (r >= 1.6 && archY(Math.min(x0 + 2 * r, W / 2)) - DECK - 1.2 < 2 * r) r -= 0.2;
  if (r < 1.6 || x0 + 2 * r > W / 2) break;
  half.push({ cx: x0 + r, cy: DECK + 0.6 + r, r });
  x0 += 2 * r + 1.4;
}
const rings = [...half, ...half.map((ring) => ({ ...ring, cx: W - ring.cx }))].map((ring) => ({
  cx: +ring.cx.toFixed(2),
  cy: +ring.cy.toFixed(2),
  r: +ring.r.toFixed(2),
}));

let instances = 0;
const id = `puente-${++instances}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg class={className} aria-hidden="true" focusable="false">
  <defs>
    <pattern
      id={id}
      width={W}
      height={H}
      patternUnits="userSpaceOnUse"
      patternTransform={scale !== 1 ? `scale(${scale})` : undefined}
    >
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <!-- Barandilla y tablero. -->
        <path d={`M0 ${DECK - 5}H${W}M0 ${DECK}H${W}`} />
        <!-- Farolas sobre las pilas. -->
        <path d={`M0 ${DECK - 5}V3M${W} ${DECK - 5}V3`} />
        <!-- Arco: trasdós e intradós. -->
        <path d={`M0 ${H}Q${W / 2} ${CONTROL_Y} ${W} ${H}`} />
        <path d={`M9 ${H}Q${W / 2} ${CONTROL_Y + 12} ${W - 9} ${H}`} stroke-opacity="0.6" />
        {rings.map((ring) => <circle cx={ring.cx} cy={ring.cy} r={ring.r} />)}
      </g>
      <g fill="currentColor">
        <circle cx="0" cy="3" r="2.2" />
        <circle cx={W} cy="3" r="2.2" />
        <!-- Pilas. -->
        <rect x="0" y={H - 14} width="5" height="14" />
        <rect x={W - 5} y={H - 14} width="5" height="14" />
      </g>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
